# =============================================================================
# Agent Smith — .gitignore
# Python 3.10 · uv · Docker · MCP · LLM APIs
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & API keys — NEVER commit these
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.key
secrets/
credentials/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# uv
.uv/

# Build / distribution
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Type checking & linting
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json
.pytype/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/
*.coveragerc

# Jupyter
.ipynb_checkpoints/
*.ipynb

# -----------------------------------------------------------------------------
# Sandbox
# -----------------------------------------------------------------------------
# Sandbox temp execution outputs
/tmp/agent/
sandbox_output/
sandbox_logs/

# -----------------------------------------------------------------------------
# Evaluation outputs (generated at runtime — do NOT commit)
# -----------------------------------------------------------------------------
evaluations/
cache/
*.log
stdout.log
stderr.log

# Exception: benchmark solution.json files must be committed
# (required by the subject for BENCHMARK_REPORT.md)
# They are NOT ignored — commit them explicitly

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Never commit pulled images or container artifacts
*.tar
docker-compose.override.yml

# -----------------------------------------------------------------------------
# LLM / Model weights
# -----------------------------------------------------------------------------
# The subject explicitly forbids committing model weights
*.bin
*.safetensors
*.gguf
*.pt
*.pth
*.ckpt
models/
weights/

# -----------------------------------------------------------------------------
# OS & editors
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains
.idea/
*.iml

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.bak
*.tmp
*.orig
.direnv/


logs.txt
